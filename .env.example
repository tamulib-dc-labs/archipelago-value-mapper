# Copy to .env.local (gitignored) and fill in. It is read from the directory
# you run value-mapper in; anything already set in your shell takes precedence.
#
# One Drupal account per instance. Its role needs "Read Archipelago metadata
# values" (the tamu_metadata_api module), and edit access to Digital Objects
# for updates.
ARCHIPELAGO_PROD_USER=your-prod-drupal-username
ARCHIPELAGO_PROD_PASSWORD=your-prod-drupal-password
ARCHIPELAGO_LOCAL_USER=your-local-drupal-username
ARCHIPELAGO_LOCAL_PASSWORD=your-local-drupal-password
